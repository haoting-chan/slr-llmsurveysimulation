# Copy this file to `.env` and fill in your own keys. Never commit `.env`.
# Only needed to re-run the database searches in notebooks/SLR1_Database_extraction.ipynb.

# Web of Science Starter API (Clarivate): https://developer.clarivate.com/apis/wos-starter
WEB_OF_SCIENCE_API_KEY=

# Semantic Scholar Academic Graph API: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Perplexity API (loaded in SLR1 but not required for the reported searches)
PERPLEXITY_API_KEY=
