	title = {Synthetic {Voices}: {Evaluating} the {Fidelity} of {LLM}-{Generated} {Personas} in {Representing} {People}’s {Financial} {Wellbeing} {\textbar} {Proceedings} of the 33rd {ACM} {Conference} on {User} {Modeling}, {Adaptation} and {Personalization}},
