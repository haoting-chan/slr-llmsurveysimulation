\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9780470891056.ch14},
	keywords = {data collection, data editing, imputation technique, item nonresponse, missing data mechanism, unit nonresponse},
	pages = {418--442},
}

@incollection{MiscellaneousTopics2011,
	title = {Miscellaneous {Topics}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch15},
	doi = {10.1002/9780470891056.ch15},
	abstract = {This chapter discusses a number of situations that require a different approach to nonresponse. It describes methods to deal with a combination of item and unit nonresponse. The chapter talks about panel surveys that have become a popular way of collecting data with the introduction of the Internet as a data collection mode. A key element of the analysis of nonresponse and successful adjustment for nonresponse bias is the availability of good auxiliary information about respondents and nonrespondents. This information can come from external administrative sources. But also information about the data collection process can provide useful insights into the response process. The weighting technique that is most commonly used to adjust for nonresponse bias is the generalized regression (GREG) estimator. This method of repeated weighting has been developed for use in the Dutch Virtual Census. Controlled Vocabulary Terms data collection; surveys},
