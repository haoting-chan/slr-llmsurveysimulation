@article{hahnDailyHasslesChronic1999,
	title = {Daily hassles and chronic stressors: conceptual and measurement issues},
	volume = {15},
	copyright = {Copyright © 1999 John Wiley \& Sons, Ltd.},
	issn = {1099-1700},
	shorttitle = {Daily hassles and chronic stressors},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/%28SICI%291099-1700%28199904%2915%3A2%3C89%3A%3AAID-SMI789%3E3.0.CO%3B2-O},
	doi = {10.1002/(SICI)1099-1700(199904)15:2<89::AID-SMI789>3.0.CO;2-O},
	abstract = {Researchers have studied similar stressful events under different construct labels. This study examined three explanations for the overlap: definitional confusion, measurement problems associated with using normative measures to assess stressful events and poor measure development. Two types of stressors, hassles and chronic stressors, were used to examine the overlap issue. A literature review indicated that overlapping definitions of hassles and chronic stressors have been widely used by researchers. Items from traditional work and non-work hassles and chronic stressor measures were categorized by 323 hospital employees as either hassles or chronic stressors. Results revealed that items from traditional hassles measures were not consistently categorized by participants as hassles but were categorized by some as chronic stressors. A similar inconsistent categorization was found for chronic stressors. Results suggest that traditional normative measures of hassles and chronic stressors may be inadequate. Implications of these results for acute stressor measurement are discussed. Copyright © 1999 John Wiley \& Sons, Ltd.},
	language = {en},
	number = {2},
	urldate = {2025-09-27},
	journal = {Stress Medicine},
	author = {Hahn, Susan E. and Smith, Carlla S.},
	year = {1999},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/\%28SICI\%291099-1700\%28199904\%2915\%3A2\%3C89\%3A\%3AAID-SMI789\%3E3.0.CO\%3B2-O},
	keywords = {stress, chronic stressors, daily hassles, measurement},
	pages = {89--101},
}

@article{seridoChronicStressorsDaily2004,
	title = {Chronic {Stressors} and {Daily} {Hassles}: {Unique} and {Interactive} {Relationships} with {Psychological} {Distress}∗},
	volume = {45},
	issn = {0022-1465},
	shorttitle = {Chronic {Stressors} and {Daily} {Hassles}},
	url = {https://doi.org/10.1177/002214650404500102},
	doi = {10.1177/002214650404500102},
	abstract = {Using daily telephone interviews of a U.S. national sample of adults, aged 25–74 (N = 1,031), the present analyses draw from theories of the stress process and recent research to examine how chronic role-related stressors and daily hassles affect psychological distress. Four separate hypotheses are examined. The first explores the association between chronic stressors and daily hassles. The second tests whether daily hassles function as an intervening variable between chronic stressors and psychological distress. The third tests whether a chronic stressor moderates the relationship between daily hassles and psychological distress. The fourth hypothesis tests for cross-domain effects of chronic stressors and daily hassles. Findings indicate that chronic stressors and daily hassles are distinct types of stressors with unique contributions to psychological distress. The study provides support for chronic home stressors functioning as a moderating factor on the relationship between daily hassles and psychological distress both within and across domains.},
	language = {EN},
	number = {1},
	urldate = {2025-09-27},
	journal = {Journal of Health and Social Behavior},
	publisher = {SAGE Publications Inc},
	author = {Serido, Joyce and Almeida, David M. and Wethington, Elaine},
