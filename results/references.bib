	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch3},
	doi = {10.1002/9780470891056.ch3},
	abstract = {There are two ways to do something about the nonresponse problem. One way is to prevent nonresponse from happening during the fieldwork of the survey. The second way of doing something about nonresponse is to correct estimates for a possible bias. This chapter is about reducing nonresponse in the field and focuses on the psychological aspects of nonresponse reduction research. It looks at the psychological component of obtaining participation from persons for a survey and the practical implications that result in measures used to reduce nonresponse. The chapter presents a number of theories from the literature about survey participation. This is followed by a discussion on the measures used to reduce nonresponse. For the methods to reduce nonresponse, the following three causes of nonresponse are followed: language problems, noncontact, or refusal. Controlled Vocabulary Terms surveys},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
