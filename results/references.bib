	keywords = {nonresponse, auxiliary variable, bivariate methods, Cramer’s V statistic, General Population Survey (GPS), multivariate methods},
	pages = {122--146},
}

@incollection{InternationalComparisonNonresponse2011,
	title = {An {International} {Comparison} of {Nonresponse}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch6},
	doi = {10.1002/9780470891056.ch6},
	abstract = {The response rate of a survey and the composition of the nonresponses are determined by many different factors. One of these factors may be the country in which a survey is conducted. The meso level consists of factors affecting nonresponse due to the survey’s design and the organization of the fieldwork. Depending on the type and amount of data available, several theoretical approaches are possible to investigate nonresponse differences between countries. By including year and survey as explanatory variables in the model, it is possible to detect survey effects and trends over time. Correspondence analysis is used to identify and explore existing relationships in contingency tables. The chapter concludes with a discussion on multinomial multilevel modeling and the European Social Survey (ESS). Controlled Vocabulary Terms correspondence analysis; surveys},
