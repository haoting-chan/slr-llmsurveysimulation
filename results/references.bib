@misc{zhuPersonalityAlignmentLarge2024,
	title = {Personality {Alignment} of {Large} {Language} {Models}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2408.11779},
	doi = {10.48550/ARXIV.2408.11779},
	abstract = {Aligning large language models (LLMs) typically aim to reflect general human values and behaviors, but they often fail to capture the unique characteristics and preferences of individual users. To address this gap, we introduce the concept of Personality Alignment. This approach tailors LLMs' responses and decisions to match the specific preferences of individual users or closely related groups. Inspired by psychometrics, we created the Personality Alignment with Personality Inventories (PAPI) dataset, which includes data from over 320,000 real subjects across multiple personality assessments, including both the Big Five Personality Factors and Dark Triad traits. This comprehensive dataset enables quantitative evaluation of LLMs' alignment capabilities across both positive and potentially problematic personality dimensions. Recognizing the challenges of personality alignments, such as limited personal data, diverse preferences, and scalability requirements, we developed an activation intervention optimization method. This method enhances LLMs' ability to efficiently align with individual behavioral preferences using minimal data and computational resources. Remarkably, our method, PAS, achieves superior performance while requiring only 1/5 of the optimization time compared to DPO, offering practical value for personality alignment. Our work paves the way for future AI systems to make decisions and reason in truly personality ways, enhancing the relevance and meaning of AI interactions for each user and advancing human-centered artificial intelligence. The dataset and code are released at https://github.com/zhu-minjun/PAlign.},
	urldate = {2025-12-07},
	publisher = {arXiv},
	author = {Zhu, Minjun and Weng, Yixuan and Yang, Linyi and Zhang, Yue},
	year = {2024},
	note = {Version Number: 2},
	keywords = {Computation and Language (cs.CL), FOS: Computer and information sciences},
}

@article{reveilhacChatGPTVotingApplication2025,
	title = {{\textless}span style="font-variant:small-caps;"{\textgreater}{ChatGPT}{\textless}/span{\textgreater} as a voting application in direct democracy},
	volume = {31},
	issn = {1424-7755, 1662-6370},
	shorttitle = {{\textless}span style="font-variant},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/spsr.12650},
	doi = {10.1111/spsr.12650},
	abstract = {Abstract
            The study examines the potential role of ChatGPT as a tool for popular voting. It assesses ChatGPT's positions on four voting objects (three initiatives and one referendum) by simulating various Swiss voter profiles (neutral, centrist, left, right, progressist, and conservative) and comparing these to its default stance. Additionally, ChatGPT's responses to arguments for and against each object were analyzed for consistency with its voting patterns. The study compared ChatGPT's decisions to real voting outcomes, fixing the temperature and collecting 100 answers per question to ensure reliability. Results showed that voting decisions varied by model version (GPT‐3.5 or GPT‐4) and language (French or German), indicating cultural and model iteration influences. ChatGPT's decisions did not consistently align with a left‐progressist stance, highlighting the impact of language, model versions, and contextual factors on political interpretations.
          , 
            Zusammenfassung
            Die Studie untersucht die potenzielle Rolle von ChatGPT als Instrument bei Volksabstimmungen. Sie bewertet die Positionen von ChatGPT zu vier Abstimmungsgegenständen (drei Initiativen und einem Referendum), indem verschiedene Schweizer Wählerprofile (neutral, Mitte, links, rechts, progressiv und konservativ) simuliert und mit der Standardhaltung von ChatGPT verglichen werden. Zudem wurden die Antworten von ChatGPT auf Argumente für und gegen jedes Abstimmungsobjekt auf ihre Übereinstimmung mit den Abstimmungsmustern analysiert. Die Entscheidungen von ChatGPT wurden mit den tatsächlichen Abstimmungsergebnissen verglichen, wobei eine feste Temperatur verwendet und 100 Antworten pro Frage gesammelt wurden. Die Ergebnisse zeigen, dass die Abstimmungsentscheidungen je nach Modellversion (GPT‐3.5 oder GPT‐4) und Sprache (Französisch oder Deutsch) variierten, was auf kulturelle und modellbedingte Einflüsse hinweist. Die Entscheidungen von ChatGPT stimmten nicht durchgehend mit einer links‐progressiven Haltung überein, was darauf hindeutet, dass Sprache, Modellversionen und Kontextfaktoren sich auf politische Interpretationen auswirken.
          , 
            Résumé
            L'étude explore le rôle potentiel de ChatGPT dans le cadre des votations populaires. Elle examine les positions de ChatGPT sur quatre objets de vote (trois initiatives et un référendum) en simulant divers profils d'électeurs suisses (neutre, centriste, de gauche, de droite, progressiste et conservateur) et en les comparant à sa position par défaut. Les réponses de ChatGPT aux arguments pour et contre chaque objet ont été analysées afin d'évaluer leur cohérence avec les schémas de vote. L'étude a également comparé les décisions de ChatGPT aux résultats réels des votes, en fixant la température et en collectant 100 réponses par question pour assurer une fiabilité optimale. Les résultats ont révélé que les décisions de vote variaient en fonction de la version du modèle (GPT‐3.5 ou GPT‐4) et de la langue utilisée (français ou allemand), mettant en évidence des influences culturelles et des différences liées aux itérations du modèle. Les décisions de ChatGPT ne correspondaient pas systématiquement à une position gauche‐progressiste, soulignant l'impact de la langue, des versions du modèle et des facteurs contextuels sur les interprétations politiques.
          , 
            Riassunto
            Lo studio analizza il ruolo potenziale di ChatGPT come strumento per le votazioni popolari, esaminando le posizioni di ChatGPT su quattro oggetti di voto (tre iniziative e un referendum) tramite la simulazione di diversi profili di elettori svizzeri (neutro, centrista, di sinistra, di destra, progressista e conservatore) e confrontandoli con la posizione predefinita del modello. Vengono analizzate, inoltre, le risposte di ChatGPT agli argomenti a favore e contro ciascun oggetto per verificarne la coerenza con i suoi schemi di voto. Infine, sono state confrontate le decisioni di ChatGPT con i risultati reali delle votazioni, fissando una temperatura costante e raccogliendo 100 risposte per domanda al fine di garantirne l'affidabilità. I risultati evidenziano che le decisioni di voto variano in base alla versione del modello (GPT‐3.5 o GPT‐4) e alla lingua utilizzata (francese o tedesco), indicando influenze culturali e legate all'evoluzione del modello. Le decisioni di ChatGPT non risultano sistematicamente allineate a una posizione progressista di sinistra, sottolineando l'impatto della lingua, delle version del modello e dei fattori contestuali sulle interpretazioni politiche.},
	language = {en},
	number = {3},
	urldate = {2025-12-07},
	journal = {Swiss Political Science Review},
	author = {Reveilhac, Maud and Morselli, Davide},
