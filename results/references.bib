@misc{vonderheydeVoxPopuliVox2023,
	title = {Vox {Populi}, {Vox} {AI}? {Using} {Language} {Models} to {Estimate} {German} {Public} {Opinion}},
	copyright = {https://creativecommons.org/licenses/by-nd/4.0/legalcode},
	shorttitle = {Vox {Populi}, {Vox} {AI}?},
	url = {https://osf.io/8je9g},
	doi = {10.31235/osf.io/8je9g},
	abstract = {The recent development of large language models (LLMs) has spurred discussions about whether LLM-generated “synthetic samples” could complement or replace traditional surveys, considering their training data potentially reflects attitudes and behaviors prevalent in the population. A number of mostly US-based studies have prompted LLMs to mimic survey respondents, finding that the responses closely match the survey data. However, several contextual factors related to the relationship between the respective target population and LLM training data might affect the generalizability of such findings. In this study, we investigate the extent to which  LLMs can estimate public opinion in Germany, using the example of vote choice as outcome of interest. To generate a synthetic sample of eligible voters in Germany, we create personas matching the individual characteristics of the 2017 German Longitudinal Election Study respondents. Prompting GPT-3 with each persona, we ask the LLM to predict each respondents’ vote choice in the 2017 German federal elections and compare these predictions to the survey-based estimates on the aggregate and subgroup levels. We find that GPT-3 does not predict citizens’ vote choice accurately, exhibiting a bias towards the Green and Left parties, and making better predictions for more “typical” voter subgroups. While the language model is able to capture broad-brush tendencies tied to partisanship, it tends to miss out on the multifaceted factors that sway individual voter choices. Furthermore, our results suggest that GPT-3 might not be reliable for estimating nuanced, subgroup-specific political attitudes. By examining the prediction of voting behavior using LLMs in a new context, our study contributes to the growing body of research about the conditions under which LLMs can be leveraged for studying public opinion. The findings point to disparities in opinion representation in LLMs and underscore the limitation of applying them for public opinion estimation without accounting for the biases in their training data.},
	urldate = {2024-04-28},
	publisher = {Open Science Framework},
	author = {Von Der Heyde, Leah and Haensch, Anna-Carolina and Wenz, Alexander},
	month = dec,
	year = {2023},
}

@misc{thomasTrajectoriesResilienceMultiperspective2023,
	title = {Trajectories of resilience: {A} multi-perspective systematic review project},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://osf.io/a9hwn/},
	abstract = {Resilience is the maintenance or quick regain of mental health during or after stressor exposure. Starting with a hallmark theoretical paper on responses to potentially traumatic events (Bonanno, 2004), research into resilience is intertwined with research into trajectories of mental distress. The current systematic review project will summarize previous trajectory-based research from three perspectives: 1) the project will shed light on determinants of prevalence estimates for the characteristic trajectories; 2) the project will examine resilience factors as predictors of these trajectories; and 3) will summarize what can be learned about the phenomena of posttraumatic growth based on previous research into resilience trajectories.},
	urldate = {2024-04-08},
	publisher = {Open Science Framework},
	author = {Thomas, Lea and Schäfer, Sarah K. and Witthöft, Michael and Lieb, Klaus},
	year = {2023},
	keywords = {Psychology, Clinical Psychology, FOS: Psychology, Health Psychology, Medicine and Health Sciences, Other Psychiatry and Psychology, Psychiatry and Psychology, Social and Behavioral Sciences},
}

@misc{schaferIndividualSocialSocietal2023,
	title = {Individual, social and societal resilience factors in the face of societal challenges and crises: {A} systematic review of adult populations from {OECD} member states},
	shorttitle = {Individual, social and societal resilience factors in the face of societal challenges and crises},
	url = {https://osf.io/vwq9c},
	doi = {10.31219/osf.io/vwq9c},
	abstract = {Societal challenges put public mental health at risk and result in a growing interest in resilience as trajectories of good mental health during stressor exposure. Resilience factors increase the likelihood of resilient responses. This systematic review summarizes evidence on the predictive value of individual, social and societal resilience factors. Fifty-one studies reported on various stressors (e.g., pandemics). Higher income and socioeconomic status, better emotion regulation and flexibility were related to resilient responses. Findings were mixed for most factors supporting the importance of the fit between resilience factors and situational demands. Research into social and societal resilience factors is needed.},
	urldate = {2024-02-23},
	publisher = {Open Science Framework},
	author = {Schäfer, Sarah K. and Supke, Max and Kausmann, Corinna and Schaubruch, Lea Marga and Lieb, Klaus and Cohrdes, Caroline},
	year = {2023},
}

@misc{atariWhichHumans2023,
	title = {Which {Humans}?},
	url = {https://osf.io/5b26t},
	doi = {10.31234/osf.io/5b26t},
	abstract = {Large language models (LLMs) have recently made vast advances in both generating and analyzing textual data. Technical reports often compare LLMs’ outputs with “human” performance on various tests. Here, we ask, “Which humans?” Much of the existing literature largely ignores the fact that humans are a cultural species with substantial psychological diversity around the globe that is not fully captured by the textual data on which current LLMs have been trained. We show that LLMs’ responses to psychological measures are an outlier compared with large-scale cross-cultural data, and that their performance on cognitive psychological tasks most resembles that of people from Western, Educated, Industrialized, Rich, and Democratic (WEIRD) societies but declines rapidly as we move away from these populations (r = -.70). Ignoring cross-cultural diversity in both human and machine psychology raises numerous scientific and ethical issues. We close by discussing ways to mitigate the WEIRD bias in future generations of generative language models.},
	urldate = {2024-02-24},
	publisher = {PsyArXiv},
	author = {Atari, Mohammad and Xue, Mona J. and Park, Peter S. and Blasi, Damián Ezequiel and Henrich, Joseph},
	month = sep,
	year = {2023},
}

