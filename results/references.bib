\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9780470891056.ch7},
	keywords = {nonresponse, data collection, general population survey (GPS), partial R-indicators, representative response, representativeness (R) indicators},
	pages = {178--208},
}

@incollection{WeightingAdjustmentTechniques2011,
	title = {Weighting {Adjustment} {Techniques}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch8},
	doi = {10.1002/9780470891056.ch8},
	abstract = {Selective nonresponses will often cause estimators to be biased, so something has to be done to correct for a possible bias. A frequently used family of techniques is weighting adjustment. Adjustment weighting is based on the use of auxiliary information. This chapter describes several weighting techniques starting with the simplest and most commonly used one: poststratification. Next, linear weighting is described, which is more general than poststratification. This technique can be applied in situations where the auxiliary information is inadequate for poststratification. Then, the chapter talks about multiplicative weighting as an alternative for linear weighting. Further, an introduction to calibration is provided. This can be seen as an even more general theoretical framework for adjustment weighting that includes linear weighting and multiplication as special cases. Controlled Vocabulary Terms non-response bias},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
	year = {2011},
	note = {Section: Eight
\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9780470891056.ch8},
	keywords = {nonresponse, auxiliary information, calibration, linear weighting, multiplicative weighting, poststratification, weighting adjustment techniques},
	pages = {209--246},
}

@incollection{SelectionAuxiliaryVariables2011,
	title = {Selection of {Auxiliary} {Variables}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch9},
	doi = {10.1002/9780470891056.ch9},
	abstract = {This chapter discusses the selection of auxiliary variables for nonresponse adjustment. Auxiliary variables are variables that are external to the survey; they are (also) measured outside the survey. The auxiliary variables used for nonresponse adjustment are often termed weighting variables, so adhering to the fact that they form the input to adjustment weights. Recently a number of attempts have been made to formalize and methodize the selection of auxiliary variables. First, the chapter describes various variable selection approaches. The selection problem concerns the difference between nonresponse analysis and nonresponse adjustment. Next, it explains the strategies that underlie the selection of auxiliary variables. The variable selection strategies are then applied to General Population Survey (GPS). Variable-specific selections call for each survey variable to be adjusted separately based on smaller and more effective models. As a consequence there is a reduced risk of large standard errors. Controlled Vocabulary Terms dependent variables; surveys},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
	year = {2011},
	note = {Section: Nine
\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9780470891056.ch9},
	keywords = {survey, general population survey (GPS), auxiliary variable selection, variable selection approaches, weighting variables},
	pages = {247--288},
}

@incollection{ReApproachingNonrespondents2011,
	title = {Re-{Approaching} {Nonrespondents}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch10},
	doi = {10.1002/9780470891056.ch10},
	abstract = {There are two ways to obtain information on the nonrespondents: linking data sets and re-approaching nonrespondents. For the latter case, the literature suggests two methods: the callback approach (CBA) and the basic-question approach (BQA). This chapter presents the theory behind the CBA, the BQA, and also the Politz-Simmons approach. The application of the CBA and the BQA to the Dutch Labor Force Survey (LFS) is discussed. The implementation of these approaches is discussed, and the results are analyzed using linked data. In both re-approach types the conclusions about the employment status of the nonconverted nonrespondents should be drawn with care. While there is an indication in both cases that the nonrespondents resemble the converted nonrespondents in terms of socioeconomic characteristics, the low conversion rate of refusals leaves ample room for differences in employment status.},
	language = {en},
	urldate = {2025-12-02},
