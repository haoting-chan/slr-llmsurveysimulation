	keywords = {nonresponse, correspondence analysis, European Social Survey (ESS), meso level, multinomial multilevel modeling, survey},
	pages = {147--177},
}

@incollection{NonresponseRepresentativity2011,
	title = {Nonresponse and {Representativity}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch7},
	doi = {10.1002/9780470891056.ch7},
	abstract = {This chapter introduces the concept of representative response. From representative response it is a small step to quality indicators, called representativeness indicators or R-indicators for short. First, the chapter defines the representative response. It also defines R-indicators that are further linked to nonresponse bias. The chapter talks about additional indicators called partial R-indicators. Guidelines are presented for the use of these indicators in practical settings. The chapter applies the theory of R-indicators and partial R-indicators to the General Population Survey (GPS). R-indicators and partial R-indicators measure deviations from representative response and conditionally representative response. These indicators have three purposes: comparing the quality of response for different surveys or the same survey at different times, evaluating the quality of response to a single survey in time, and monitoring response quality during data collection. Controlled Vocabulary Terms data collection},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
	year = {2011},
