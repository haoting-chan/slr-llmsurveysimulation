@incollection{ItemNonresponse2011,
	title = {Item {Nonresponse}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch14},
	doi = {10.1002/9780470891056.ch14},
	abstract = {Nonresponse is the phenomenon where persons in the sample from the population do not provide the requested information or provide information that is not usable. Two types of nonresponses can be distinguished: unit nonresponse and item nonresponse. Item nonresponse can occur, among other ways, as a consequence of a data-editing procedure. There is no guarantee that an imputation technique will reduce a bias caused by item nonresponse. Bias reduction depends on the properties of the missing data mechanism and the specific imputation technique that is applied. The chapter also discusses the properties of single imputation. The possible effects of imputation on bias and variance are shown by analyzing two single imputation techniques in some more detail: imputation of the mean and random imputation. Imputation is most effective when values are missing at random (MAR) and the relevant auxiliary variables are used in the imputation model. Controlled Vocabulary Terms data collection; non-response error},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
