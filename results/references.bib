\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9780470891056.ch3},
	keywords = {nonresponse, language problems, noncontact, refusal rate, survey design},
	pages = {63--83},
}

@incollection{NonresponseModeData2011,
	title = {Nonresponse and the {Mode} of {Data} {Collection}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch4},
	doi = {10.1002/9780470891056.ch4},
	abstract = {This chapter presents an overview of the developments that have led to various forms of data collection: face-to-face surveys, telephone surveys, mail surveys, CAPI, CATI, CASI, Web surveys, and mixed mode surveys. They all have a specific impact on the size and structure of the nonresponse problem. The chapter describes the several modes of data collection and the effect they have on nonresponse. This is followed by a discussion on the use of sampling. The idea of using sampling instead of a complete enumeration came up around the year 1895. The chapter focuses specifically on quota sampling. National statistical institutes are facing a challenge to reduce data collection costs, on the one hand, and to publish more detailed statistical information, on the other. New ways of data collecting are being considered in which Web surveys are expected to initiate the far-reaching change of replacing expensive CAPI and CATI surveys. Controlled Vocabulary Terms data collection; sampling; Web surveys},
	language = {en},
	urldate = {2025-12-02},
