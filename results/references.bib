}

@incollection{AnalysisNonresponse2011,
	title = {Analysis of {Nonresponse}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch5},
	doi = {10.1002/9780470891056.ch5},
	abstract = {This chapter describes how bivariate and multivariate methods can be used to analyze response behavior with the use of auxiliary variables. The bivariate methods can be used to evaluate the relationship between one auxiliary variable and the response behavior. Both the statistical measure and the graphical representation of a bivariate relationship are illustrated using a real survey data set, the General Population Survey (GPS). The chapter demonstrates the testing of the relationship between the auxiliary variables and the response behavior with Cramer’s V statistic. It further provides a graphical representation of the different relationships. Two series of graphs are presented. The first series examines the relationship between each auxiliary variable and response/nonresponse. The second series show the relationship between each auxiliary variable and the fieldwork result, with categories response, refusal, no contact, not-able, and unprocessed. Controlled Vocabulary Terms bivariate analysis; control variate; non-response error},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
