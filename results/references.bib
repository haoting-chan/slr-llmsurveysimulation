	title = {Whose opinions do language models reflect?},
	volume = {202},
	abstract = {Language models (LMs) are increasingly being used in open-ended contexts, where the opinions they reflect in response to subjective queries can have a profound impact, both on user satisfaction, and shaping the views of society at large. We put forth a quantitative framework to investigate the opinions reflected by LMs – by leveraging high-quality public opinion polls. Using this framework, we create OpinionQA, a dataset for evaluating the alignment of LM opinions with those of 60 US demographic groups over topics ranging from abortion to automation. Across topics, we find substantial misalignment between the views reflected by current LMs and those of US demographic groups: on par with the Democrat-Republican divide on climate change. Notably, this misalignment persists even after explicitly steering the LMs towards particular groups. Our analysis not only confirms prior observations about the left-leaning tendencies of some human feedback-tuned LMs, but also surfaces groups whose opinions are poorly reflected by current LMs (e.g., 65+ and widowed individuals).},
	urldate = {2025-11-30},
	booktitle = {Proceedings of the 40th {International} {Conference} on {Machine} {Learning}},
	publisher = {JMLR.org},
	author = {Santurkar, Shibani and Durmus, Esin and Ladhak, Faisal and Lee, Cinoo and Liang, Percy and Hashimoto, Tatsunori},
	month = jul,
	year = {2023},
	pages = {29971--30004},
}

@incollection{NonresponseProblem2011a,
	title = {The {Nonresponse} {Problem}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch1},
	doi = {10.1002/9780470891056.ch1},
	abstract = {This chapter provides a general introduction on the phenomenon of nonresponse and its effect on the usefulness of survey-based estimates. Surveys are often compromised by nonresponse. Two types of nonresponse can be distinguished: unit nonresponse and item nonresponse. A consequence of unit nonresponse is that the realized sample size is smaller than planned. Nonresponse is just one thing that can go wrong in a survey. There will always be some error in survey estimates of population characteristics. This error can have many explanations. The ultimate result of all errors is a discrepancy between the survey estimate and the population characteristic to be estimated. This discrepancy is called the total survey error. Two broad categories can be distinguished contributing to this total error: sampling errors and nonsampling errors. Undercoverage can also occur if the sample selected is from a different population than the one intended. Controlled Vocabulary Terms non-response error; non-sampling errors; sampling; sampling errors; surveys},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
	year = {2011},
	note = {Section: One
\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9780470891056.ch1},
	keywords = {surveys, nonresponse, sampling, total survey error, undercoverage},
	pages = {1--25},
}

@incollection{BasicTheoreticalConcepts2011,
	title = {Basic {Theoretical} {Concepts}},
	isbn = {978-0-470-89105-6},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9780470891056.ch2},
	doi = {10.1002/9780470891056.ch2},
	abstract = {Nonresponse is one of a number of phenomena that can affect the accuracy of survey results. To illustrate the possible consequences of nonresponses, a theoretical framework is described in this chapter. The chapter introduces the basic concepts of survey sampling. Some descriptions of sampling designs and estimation procedures follow, and then it is shown how nonresponse can be included in the theory. Two models are presented: the fixed response model and the random response model. The application of this theory should make it clear that nonresponse prevents standard confidence intervals from being used to measure the accuracy of the estimates. Finally, the chapter discusses three mechanisms that demonstrate how missing values can occur. These mechanisms help elucidate how detrimental nonresponse can be, and how it is possible to correct survey outcomes for nonresponse. Controlled Vocabulary Terms non-response error; Sampling; surveys},
	language = {en},
	urldate = {2025-12-02},
	booktitle = {Handbook of {Nonresponse} in {Household} {Surveys}},
	publisher = {John Wiley \& Sons, Ltd},
	year = {2011},
	note = {Section: Two
\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9780470891056.ch2},
	keywords = {nonresponse, fixed response model, missing data mechanisms, random response model, sampling designs, survey results, survey sampling},
	pages = {26--62},
}

@incollection{ReducingNonresponse2011,
	title = {Reducing {Nonresponse}},
